pipeline {
  agent any

  environment {
    DEPLOY_USER = "deploy"
    DEPLOY_HOST = "127.0.0.1"
    SSH_KEY     = "/var/lib/jenkins/.ssh/hetzner_deploy_key"
    FRONT_DST   = "/var/www/harshithportfolio/frontend"
    BACK_DST    = "/opt/harshithportfolio/backend"
  }

  stages {
    stage('Checkout') { steps { checkout scm } }

    stage('Build Frontend') {
      steps {
        dir('frontend') {
          sh '''
            npm ci
            npm run build
          '''
        }
      }
    }

    stage('Deploy Frontend') {
      steps {
        sh '''
        set -e
        BUILD_DIR="frontend/dist"
        if [ -d "frontend/build" ]; then BUILD_DIR="frontend/build"; fi

        ssh -i "$SSH_KEY" -o StrictHostKeyChecking=accept-new $DEPLOY_USER@$DEPLOY_HOST "mkdir -p $FRONT_DST"
        rsync -az --delete -e "ssh -i $SSH_KEY -o StrictHostKeyChecking=accept-new" "$BUILD_DIR"/ $DEPLOY_USER@$DEPLOY_HOST:"$FRONT_DST"/
        ssh -i "$SSH_KEY" -o StrictHostKeyChecking=accept-new $DEPLOY_USER@$DEPLOY_HOST "sudo systemctl reload nginx"
      '''
      }
    }

    stage('Deploy Backend') {
      steps {
        sh '''
          set -e
          ssh -i "$SSH_KEY" -o StrictHostKeyChecking=accept-new $DEPLOY_USER@$DEPLOY_HOST "mkdir -p $BACK_DST"
          rsync -az --delete -e "ssh -i $SSH_KEY -o StrictHostKeyChecking=accept-new" backend/ $DEPLOY_USER@$DEPLOY_HOST:"$BACK_DST"/

          ssh -i "$SSH_KEY" -o StrictHostKeyChecking=accept-new $DEPLOY_USER@$DEPLOY_HOST '
            cd /opt/harshithportfolio/backend &&
            python3 -m venv venv &&
            ./venv/bin/pip install --upgrade pip &&
            ./venv/bin/pip install -r requirements.txt &&
            sudo systemctl restart harshithportfolio-api
          '
        '''
      }
    }

    stage('Health Check') {
    steps {
        sh 'curl -fsS https://harshithportfolio.com/api/health'
    }
    }

  }
}
